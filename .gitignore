# Datasets: converter code, guides, and committed prompt sets are tracked by
# default. Downloaded snapshots and generated outputs stay local-only. Adding a
# new datasets/<name>/ must not require an allowlist entry here.
datasets/**/raw/
datasets/**/processed/
datasets/video_r1_260k/**/*.jsonl
datasets/daily_omni_av/**/*.jsonl

# Default --out-dir of the datasets/ converters
/data/

# Large model artifacts (defense-in-depth)
models/**/*.bin
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.safetensors

